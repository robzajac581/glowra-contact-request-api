# Environment Variables Template
# Copy this file to .env and fill in your values. Do not commit real keys to git.

# Server
PORT=3002
NODE_ENV=development

# Database (SQL Server) — connections use encrypt: true
DB_SERVER=your_server_here
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# SendGrid — required for outbound email; sends fail without it
SENDGRID_API_KEY=

# Email routing
# Defaults are applied in utils/emailService.js if these are unset.
# When testing locally, point these at an address you control so real
# inboxes don't receive test submissions.
EMAIL_FROM=noreply@glowra.com
CONSULTATION_REQUEST_EMAIL_TO=csrequestforwarding@glowra.com
CLINIC_LISTING_EMAIL_TO=list@glowra.com
